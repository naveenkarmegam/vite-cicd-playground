{
  "name": "vite-cicd-playground",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:js": "eslint --cache --cache-strategy=content --cache-location=.cache/.eslintcache",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache --cache-strategy=content --cache-location=.cache/.stylelintcache",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:types": "tsc -b --noEmit",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:types",
    "lint:fix": "pnpm run lint:js:fix && pnpm run lint:css:fix",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,yaml,css}\" --cache --cache-strategy=content --cache-location=.cache/.prettiercache",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,yaml,css}\" --cache --cache-strategy=content --cache-location=.cache/.prettiercache",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
